# Optional overrides — connectwise-command-mcp has no required env vars.
# All authentication is per-request via the X-ConnectWise-Command-Api-Key
# request header: a Reporting API key generated in the ITSupport247 portal
# (Admin > Integration > Reporting API). This server never stores it — it
# is forwarded as HTTP Basic Auth (blank username, API key as password) on
# every ConnectWise Command / Continuum call.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Both Reporting API hosts are fixed public endpoints (not per-tenant) —
# override only if ConnectWise migrates these hostnames.
# CONNECTWISE_COMMAND_LEGACY_BASE_URL=https://itsapi.itsupport247.net/reportingapi/ReportingAPIService.svc/json
# CONNECTWISE_COMMAND_SITES_BASE_URL=https://api.itsupport247.net
